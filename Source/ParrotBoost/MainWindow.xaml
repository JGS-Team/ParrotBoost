          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Image Source="logonbg.png" Width="18" Height="18" Opacity="0.6" />
            <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center">
              <Hyperlink NavigateUri="https://github.com/JGS-Team/ParrotBoost" Style="{StaticResource FooterMutedLinkStyle}" ToolTip="https://github.com/JGS-Team/ParrotBoost" RequestNavigate="Hyperlink_RequestNavigate">
                <Run Text="v3.0.4 Stable" />
              </Hyperlink>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>
      <Border Name="ToastBanner" Grid.RowSpan="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ColorPrimaryBrush}" BorderThickness="1" CornerRadius="10" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,55" Visibility="Collapsed" Opacity="0" Panel.ZIndex="100">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.35" />
        </UIElement.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Name="ToastIconImage" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Name="ToastTitle" Text="Security Report" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Name="ToastMessage" Text="Scan completed" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="400" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid Name="ParrotDialogOverlay" RowSpan="4" Visibility="Collapsed" Opacity="0" ZIndex="200">
        <Border Background="#88000000" MouseLeftButtonDown="ParrotDialogBackdrop_MouseDown" />
        <Border Name="ParrotDialogCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <UIElement.RenderTransform>
            <ScaleTransform x:Name="ParrotDialogScale" ScaleX="0.95" ScaleY="0.95" />
          </UIElement.RenderTransform>
          <UIElement.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.4" />
          </UIElement.Effect>
          <StackPanel>
            <Border Name="ParrotDialogIconBadge" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource ColorPrimarySoft}" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed">
              <Image Name="ParrotDialogIconImage" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Name="ParrotDialogTitle" Text="ParrotBoost" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Name="ParrotDialogMessage" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" Margin="0,0,0,22" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="ParrotDialogCancelBtn" Content="{DynamicResource Dialog.Cancel}" Background="#00FFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontSize="12" MinWidth="115" Padding="18,9" Margin="0,0,10,0" Cursor="Hand" Visibility="Collapsed" Click="ParrotDialogCancelBtn_Click">
                  <FrameworkElement.Resources>
                    <ResourceDictionary>
                      <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                        <Setter Property="Border.CornerRadius" Value="10" />
                      </Style>
                    </ResourceDictionary>
                  </FrameworkElement.Resources>
                </Button>
                <Button Name="ParrotDialogConfirmBtn" Content="{DynamicResource Dialog.Ok}" Background="{DynamicResource ColorPrimaryBrush}" BorderThickness="0" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" MinWidth="115" Padding="18,9" Cursor="Hand" Click="ParrotDialogConfirmBtn_Click">
                  <FrameworkElement.Resources>
                    <ResourceDictionary>
                      <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                        <Setter Property="Border.CornerRadius" Value="10" />
                      </Style>
                    </ResourceDictionary>
                  </FrameworkElement.Resources>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Grid Name="SplashOverlay" RowSpan="4" Background="{DynamicResource WindowBackground}" Visibility="Visible" IsHitTestVisible="True" ZIndex="20" ClipToBounds="True">
        <StackPanel Name="SplashContentPanel" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <UIElement.RenderTransform>
            <ScaleTransform x:Name="SplashScale" ScaleX="1" ScaleY="1" />
          </UIElement.RenderTransform>
          <Border Width="88" Height="88" CornerRadius="44" Background="#142ECC71" Margin="0,0,0,14" HorizontalAlignment="Center">
            <Image Name="SplashLogo" Source="pack://application:,,,/logonbg.png" Width="68" Height="68" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Parrot" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="Boost" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ColorPrimaryBrush}" />
          </StackPanel>
          <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0">
            <Hyperlink NavigateUri="https://github.com/JGS-Team/ParrotBoost" Style="{StaticResource FooterMutedLinkStyle}" RequestNavigate="Hyperlink_RequestNavigate">
              <Run Text="v3.0.4 Stable" />
            </Hyperlink>
            <Run Text=" • " />
            <Hyperlink NavigateUri="https://github.com/JGS-Team" Style="{StaticResource FooterAccentLinkStyle}" RequestNavigate="Hyperlink_RequestNavigate">
              <Run Text="JGS-Team" />
            </Hyperlink>
          </TextBlock>
          <ProgressBar IsIndeterminate="True" Width="180" Height="3" Margin="0,24,0,0" Background="{DynamicResource SurfaceTrackBrush}" BorderThickness="0" Foreground="{DynamicResource ColorPrimaryBrush}" />
        </StackPanel>
        <Canvas Name="SplashCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True" IsHitTestVisible="False" />
      </Grid>
    </Grid>
    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="12" Background="#00FFFFFF" IsHitTestVisible="False" Panel.ZIndex="30" />
  </Grid>
</Window>