<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ParrotBoost.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="ParrotBoost" Height="600" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{DynamicResource WindowBackground}" AllowsTransparency="False" WindowStyle="None" Icon="logo.ico" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified" xmlns:parrotboost="clr-namespace:ParrotBoost;assembly=ParrotBoost">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="45" GlassFrameThickness="0" CornerRadius="12" NonClientFrameEdges="None" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardBackground" Color="White" />
      <SolidColorBrush x:Key="TextPrimary" Color="#0B2417" />
      <SolidColorBrush x:Key="TextSecondary" Color="#254D37" />
      <SolidColorBrush x:Key="BorderBrush" Color="#5C8A70" />
      <SolidColorBrush x:Key="HeaderBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ColorPrimaryBrush" Color="#2ECC71" />
      <SolidColorBrush x:Key="ColorPrimarySoft" Color="#1E2ECC71" />
      <SolidColorBrush x:Key="LinkHoverBrush" Color="#167540" />
      <SolidColorBrush x:Key="BoostButtonBorderBrush" Color="#123824" />
      <SolidColorBrush x:Key="SliderTrackBackground" Color="#DCECE2" />
      <SolidColorBrush x:Key="SliderTrackBorder" Color="#709C83" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
      <SolidColorBrush x:Key="SurfaceTrackBrush" Color="#DAEBE1" />
      <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Direction="270" RenderingBias="Quality" ShadowDepth="1" Color="#103824" Opacity="0.10" />
      <Style x:Key="SliderProgressRepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Background="{DynamicResource ColorPrimaryBrush}" Height="6" CornerRadius="3,0,0,3" SnapsToDevicePixels="True" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SliderRemainingRepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Background="{DynamicResource SliderTrackBackground}" BorderBrush="{DynamicResource SliderTrackBorder}" BorderThickness="0,1,1,1" Height="6" CornerRadius="0,3,3,0" SnapsToDevicePixels="True" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TastefulSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Grid Width="18" Height="18">
                <Ellipse Name="OuterRing" Width="16" Height="16" Fill="{DynamicResource SliderThumbBackground}" Stroke="{DynamicResource ColorPrimaryBrush}" StrokeThickness="2.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="OuterRing" Property="Width" Value="18" />
                  <Setter TargetName="OuterRing" Property="Height" Value="18" />
                  <Setter TargetName="OuterRing" Property="Shape.StrokeThickness" Value="2.6" />
                </Trigger>
                <Trigger Property="Thumb.IsDragging" Value="True">
                  <Setter TargetName="OuterRing" Property="Fill" Value="{DynamicResource ColorPrimaryBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type Slider}" TargetType="{x:Type Slider}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid VerticalAlignment="Center">
                <Track Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderProgressRepeatButton}" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderRemainingRepeatButton}" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource TastefulSliderThumbStyle}" />
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CrispCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="UIElement.Effect" Value="{x:Null}" />
        <Setter Property="Border.Padding" Value="20" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
      </Style>
      <Style x:Key="ModernCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="UIElement.Effect" Value="{StaticResource CardShadow}" />
        <Setter Property="Border.Padding" Value="20" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="Fant" />
      </Style>
      <Style x:Key="RoundBoostButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Width" Value="84" />
        <Setter Property="Height" Value="84" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Ellipse Name="circle" Fill="{TemplateBinding Control.Background}" Stroke="{DynamicResource BoostButtonBorderBrush}" StrokeThickness="2.5" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                  <ContentPresenter.ContentTemplate>
                    <DataTemplate>
                      <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="64" LineHeight="16" LineStackingStrategy="BlockLineHeight" Text="{Binding}" />
                    </DataTemplate>
                  </ContentPresenter.ContentTemplate>
                </ContentPresenter>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="circle" Property="UIElement.Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="circle" Property="RenderTransform">
                    <Setter.Value>
                      <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="42" CenterY="42" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="IconButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" CornerRadius="10" SnapsToDevicePixels="True">
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Value="{DynamicResource SurfaceTrackBrush}" Property="Border.Background" />
                  <Setter Property="UIElement.Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="border" Value="{DynamicResource SurfaceTrackBrush}" Property="Border.Background" />
                  <Setter Property="UIElement.Opacity" Value="0.65" />
                </Trigger>
                <Trigger Property="UIElement.IsFocused" Value="True">
                  <Setter TargetName="border" Property="Border.BorderThickness" Value="1" />
                  <Setter TargetName="border" Value="{DynamicResource ColorPrimaryBrush}" Property="Border.BorderBrush" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Border Name="border" Background="#00FFFFFF" BorderThickness="0,0,0,2" BorderBrush="#00FFFFFF" Margin="0,0,10,0">
                <ContentPresenter Name="content" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="TabItem.IsSelected" Value="True">
                  <Setter TargetName="border" Value="{DynamicResource ColorPrimaryBrush}" Property="Border.BorderBrush" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Value="{DynamicResource ColorPrimaryBrush}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FooterAccentLinkStyle" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextDecorations" Value="None" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="FooterMutedLinkStyle" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryBrush}" />
        <Setter Property="TextDecorations" Value="None" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Border Name="WindowFrame" Background="{DynamicResource WindowBackground}" CornerRadius="12" SnapsToDevicePixels="True" />
    <Grid Name="RootGrid" Background="{DynamicResource WindowBackground}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Name="TitleBarBorder" Grid.Row="0" Panel.ZIndex="10" Height="45" Background="{DynamicResource HeaderBackground}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="12,12,0,0" ClipToBounds="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
            <Image Source="logonbg.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="Fant" />
            <TextBlock Text="{DynamicResource MainWindow.Title}" Foreground="{DynamicResource TextPrimary}" Margin="12,0,6,0" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
            <Button Name="ThemeBtn" Style="{StaticResource IconButton}" Padding="7" Margin="0,0,4,0" ToolTip="Switch Theme" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Theme_Click">
              <Image Name="ThemeBtnIcon" Width="20" Height="20" Source="pack://application:,,,/Resources/Icons/dark_mode.png" RenderOptions.BitmapScalingMode="HighQuality" />
            </Button>
            <Button Name="SettingsBtn" Style="{StaticResource IconButton}" Padding="7" Margin="0,0,4,0" ToolTip="Settings" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Settings_Click">
              <Image Name="SettingsBtnIcon" Width="20" Height="20" Source="pack://application:,,,/Resources/Icons/settings_light.png" RenderOptions.BitmapScalingMode="HighQuality" />
            </Button>
            <Button Name="MinimizeBtn" Style="{StaticResource IconButton}" Padding="8" Margin="0,0,4,0" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click">
              <Canvas Width="16" Height="16">
                <Path Data="M 3,8 L 13,8" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
            </Button>
            <Button Name="CloseButton" Style="{StaticResource IconButton}" Padding="8" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
              <Canvas Width="16" Height="16">
                <Path Data="M 3.5,3.5 L 12.5,12.5 M 12.5,3.5 L 3.5,12.5" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border Name="UpdateNotificationBar" Grid.Row="1" Background="#27AE60" Padding="14,8" Visibility="Collapsed" Panel.ZIndex="15">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" />
            <TextBlock Name="UpdateNotificationText" Text="Nowa wersja ParrotBoost jest dostępna" Foreground="#FFFFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="UpdateNowBtn" Content="{DynamicResource MainWindow.UpdateNow}" Background="#FFFFFFFF" Foreground="#1E8449" FontWeight="Bold" Padding="12,3" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" Click="UpdateNowBtn_Click" />
            <Button Name="DismissUpdateBtn" Content="✕" Background="#00FFFFFF" Foreground="#FFFFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Click="DismissUpdateBtn_Click" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Row="2">
        <Grid Name="MainDashboard" Margin="8" Visibility="Visible" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
          <UIElement.RenderTransform>
            <ScaleTransform x:Name="DashboardScale" ScaleX="1" ScaleY="1" />
          </UIElement.RenderTransform>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="4*" />
              <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="8" VerticalAlignment="Stretch" Padding="20,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Name="GpuDriverBtn" Grid.Row="0" Content="{DynamicResource MainWindow.DriverChecking}" HorizontalAlignment="Left" Background="#00FFFFFF" BorderThickness="0" Padding="0,2" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondary}" Cursor="Hand" FontSize="11" Click="GpuDriverBtn_Click" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                  <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="{DynamicResource MainWindow.Specs}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Canvas Grid.Column="0" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top">
                        <Path Data="M 4.5,4.5 H 11.5 V 11.5 H 4.5 Z M 6.5,6.5 H 9.5 V 9.5 H 6.5 Z M 6,2 V 4.5 M 10,2 V 4.5 M 6,11.5 V 14 M 10,11.5 V 14 M 2,6 H 4.5 M 2,10 H 4.5 M 11.5,6 H 14 M 11.5,10 H 14" Stroke="{DynamicResource ColorPrimaryBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                      <TextBlock Grid.Column="1" Name="CpuInfo" Text="CPU: Loading..." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Canvas Grid.Column="0" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top">
                        <Path Data="M 2,4.5 H 14 V 11.5 H 2 Z M 5.5,8 A 2,2 0 1 1 5.499,8 Z M 10.5,6.5 H 12.5 M 10.5,9.5 H 12.5 M 4.5,11.5 V 13.2 M 7.5,11.5 V 13.2" Stroke="{DynamicResource ColorPrimaryBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                      <TextBlock Grid.Column="1" Name="GpuInfo" Text="GPU: Loading..." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,3" Visibility="{Binding Visibility, ElementName=IgpuInfo}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Canvas Grid.Column="0" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top">
                        <Path Data="M 2,4.5 H 14 V 11.5 H 2 Z M 5.5,8 A 2,2 0 1 1 5.499,8 Z M 10.5,6.5 H 12.5 M 10.5,9.5 H 12.5" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                      <TextBlock Grid.Column="1" Name="IgpuInfo" Text="iGPU: Loading..." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed" />
                    </Grid>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Canvas Grid.Column="0" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top">
                        <Path Data="M 2,5 H 14 V 10.5 H 2 Z M 4.5,7 V 8.5 M 7,7 V 8.5 M 9.5,7 V 8.5 M 11.5,7 V 8.5 M 4,10.5 V 12.5 M 6.5,10.5 V 12.5 M 9.5,10.5 V 12.5 M 12,10.5 V 12.5" Stroke="{DynamicResource ColorPrimaryBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                      <TextBlock Grid.Column="1" Name="RamInfo" Text="RAM: Loading..." Foreground="{DynamicResource TextPrimary}" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,3" Visibility="{Binding Visibility, ElementName=DiskInfo}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Canvas Grid.Column="0" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top">
                        <Path Data="M 3,2.5 H 13 V 13.5 H 3 Z M 3,10 H 13 M 10.2,11.7 H 11.2" Stroke="{DynamicResource ColorPrimaryBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Canvas>
                      <TextBlock Grid.Column="1" Name="DiskInfo" Text="Disks: Loading..." Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource CrispCard}" Margin="8" VerticalAlignment="Stretch" Padding="14,10">
              <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="184" Height="154" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Path Name="BoostGaugeTrack" Stroke="{DynamicResource SurfaceTrackBrush}" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Name="BoostGaugeProgress" Stroke="{DynamicResource ColorPrimaryBrush}" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                  <TextBlock Name="PredictedBoostHeader" Text="{DynamicResource MainWindow.PredictedBoost}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                  <TextBlock Name="BoostPercentage" Text="+5-12%" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI, Segoe UI Variable Display, Arial" Foreground="{DynamicResource ColorPrimaryBrush}" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True" UseLayoutRounding="True" />
                  <TextBlock Name="BoostPredictionDetails" Text="{DynamicResource MainWindow.AnalyzingSystem}" Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="148" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True" UseLayoutRounding="True" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <Grid Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="5*" />
              <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="8" VerticalAlignment="Stretch">
              <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,10">
                  <Grid Name="LogoContainer" Width="104" Height="104" Margin="0,0,0,12" Background="#00FFFFFF" Cursor="Hand" MouseLeftButtonDown="LogoContainer_MouseLeftButtonDown">
                    <Image Source="logonbg.png" Width="86" Height="86" RenderOptions.BitmapScalingMode="Fant" />
                  </Grid>
                  <Button Name="BoostButton" Content="{DynamicResource MainWindow.Boost}" Style="{StaticResource RoundBoostButtonStyle}" Width="84" Height="84" FontSize="14" Click="BoostButton_Click" />
                  <TextBlock Name="ProgressStatus" Text="{DynamicResource MainWindow.ReadyToBoost}" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="170" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="8" VerticalAlignment="Stretch" Padding="16,16,16,12">
              <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="LIVE PERFORMANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" HorizontalAlignment="Center" />
                <Grid Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,7,0">
